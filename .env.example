PORT=3000
ALLOWED_ORIGINS=*
DB_PATH=./data/app.db

# LOCAL TESTING ONLY: returns the login code in the API response. Never set in production.
DEV_SHOW_CODE=false

# Login emails (https://resend.com). Without a key, codes are only printed in the server log.
RESEND_API_KEY=
MAIL_FROM=Student Friendly <login@yourdomain.com>

# Live vacancies (https://developer.adzuna.com). Without keys, fictional sample listings are shown.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# AI suggestions: set ONE of these. Without a key, a keyword matcher is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
